NEXTJS_ENV=development
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Kosong di lokal: diambil dari request (dev :3000 dan preview :8787). Wajib diisi di produksi.
BETTER_AUTH_URL=
