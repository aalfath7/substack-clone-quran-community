GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL publik aplikasi, dipakai untuk tautan di email
APP_URL=http://localhost:3000
# Kosong = email hanya dicetak ke log (mode pengembangan)
RESEND_API_KEY=
EMAIL_FROM=Quran Community <noreply@example.com>
